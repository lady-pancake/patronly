# Copy to backend/.env for local development.

# Supabase Postgres connection string.
# Supabase dashboard > Connect > "Session pooler" (port 5432) works locally.
# On Vercel use the "Transaction pooler" string (port 6543) instead.
# Use the postgresql+asyncpg:// scheme; plain postgresql:// is converted automatically.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200
# Optional regex for extra origins, e.g. Vercel preview deployments.
CORS_ORIGIN_REGEX=

# development | production
ENVIRONMENT=development
